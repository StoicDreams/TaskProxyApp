{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Task Proxy",
  "version": "0.1.82",
  "identifier": "com.stoic-dreams.task-proxy",
  "build": {
    "beforeDevCommand": "trunk serve",
    "beforeBuildCommand": "trunk build --release",
    "devUrl": "http://127.0.0.1:1426",
    "frontendDist": "../dist",
    "features": []
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://cdn.myfi.ws/apps/task-proxy/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIzMEM2NTAwMUY4MjFGRTMKUldUakg0SWZBR1VNSTdCanplL3VFL3pKS3hYakhJNmZrcURiNDVod0RBaTdmc0RPWWlIM1pmTGYK"
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Task Proxy",
        "width": 1600,
        "height": 720,
        "resizable": true,
        "backgroundThrottling": "disabled",
        "devtools": true,
        "minHeight": 600,
        "minWidth": 800,
        "userAgent": "Task Proxy/0.1.82",
        "url": "/",
        "label": "taskproxy",
        "titleBarStyle": "Visible"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval' https://cdn.myfi.ws",
        "style-src": "'self' 'unsafe-inline' https://cdn.myfi.ws",
        "img-src": "'self' data: blob: https://cdn.myfi.ws",
        "font-src": "'self' data: https://cdn.myfi.ws",
        "connect-src": "'self' ipc: http://ipc.localhost https://cdn.myfi.ws https://api.myfi.ws",
        "worker-src": "'self'",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "copyright": "2026 Stoic Dreams",
    "category": "DeveloperTool",
    "shortDescription": "Dev Doc/Script/Workflow Organizer",
    "longDescription": "Developer tool for organizing developer documentation, scripts, and workflows",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "signCommand": {
        "cmd": "pwsh",
        "args": [
          "-NoProfile",
          "-NonInteractive",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "sign-windows.ps1",
          "%1"
        ]
      }
    },
    "macOS": {
      "exceptionDomain": "taskproxy"
    }
  }
}
